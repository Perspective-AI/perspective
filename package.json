{
  "name": "perspective-embed",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": "^22.22.1 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "postinstall": "vp config",
    "build": "vp run -r build",
    "dev": "vp run -r --parallel dev",
    "lint": "vp lint --fix",
    "lint:check": "vp lint",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "typecheck": "vp run -r typecheck",
    "test": "vp run -r test",
    "test:watch": "vp run -r build && vp run -r --parallel test --watch",
    "test:coverage": "vp run -r test --coverage",
    "test:ssr": "vp run -r test:ssr",
    "test:types": "attw --pack packages/sdk --ignore-rules=no-resolution && attw --pack packages/sdk-react --ignore-rules=no-resolution",
    "test:e2e": "vp run -r test:e2e",
    "test:e2e:ui": "pnpm --filter @perspective/sdk exec playwright test --ui",
    "check": "pnpm lint:check && pnpm format:check && pnpm typecheck",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "vp run -r build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.30.0",
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "^20.8.9",
    "serve": "^14.2.6",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  }
}
